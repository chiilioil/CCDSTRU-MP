  - palagay here -
}

void Update(Position pos) {
    good = 0;

    if (!S[pos.a][pos.b]) { // Seen for the first time or occupied for the first time
        S[pos.a][pos.b] = 1;
        good = 1;
    }

    if (!good && S[pos.a][pos.b] && !T[pos.a][pos.b]) { // Already seen, this will trigger expand
        T[pos.a][pos.b] = 1;
        expand(pos);
    }
}

void NextPlayerMove(Position pos) {

    if (!isOver() && start) { // Put a piece on an empty cell
        if (go) R[pos.a][pos.b] = 1;
        else    B[pos.a][pos.b] = 1;
        S[pos.a][pos.b] = 1;
        good = 1;
    }

    if (!isOver() && !start) { // Expand a piece
        if ((go && R[pos.a][pos.b]) || (!go && B[pos.a][pos.b])) {
            Update(pos);
            good = 1;
        }
    }

    if (start && countPieces(R) == 1 && countPieces(B) == 1) // Both have placed a piece
        start = 0;

    if (!isOver() && good) { // End of turn 
        good = 0;
        go   = !go;
        val++;
    }
}

void GameOver() {
    int r = countPieces(R);
    int b = countPieces(B);

    printf("\n");
    printf(DIM "  -------------------------------------------\n" RESET);

    if (r > b) {
        printf(RED_COL BOLD "      RED  WINS!" RESET
               "   Red: %d piece(s)  Blue: %d piece(s)\n", r, b);
    } else if (b > r) {
        printf(BLUE_COL BOLD "      BLUE WINS!" RESET
               "   Blue: %d piece(s)  Red: %d piece(s)\n", b, r);
    } else {
        printf(YELLOW BOLD "         DRAW!" RESET
               "   Both players have %d piece(s)\n", r);
    }

    printf(DIM "  -------------------------------------------\n" RESET);
    printf("\n");
    
    if (countFree() == 3)
        printf("  -> Board is nearly full (only 3 empty cells left).\n");
    else if (val >= 20)
        printf("  -> 16 moves have been played.\n");
    else if (countPieces(B) == 0)
        printf("  -> " BLUE_COL "Blue" RESET " lost all their pieces!\n");
    else if (countPieces(R) == 0)
        printf("  -> " RED_COL "Red" RESET " lost all their pieces!\n");

    printf("\n");
}

