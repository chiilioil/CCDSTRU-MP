void playGame(void) {
    GameState game;
    Position pos;
    int success;
    int validMove;
    int row, col;

    initialize(&game);

    while (!isOver(&game)) {
        printGameBoard(&game);

        if (game.start) {
            if (game.go) {
                printf(RED_COL "  Red" RESET " - enter an empty cell (row col): ");
            }
            else {
                printf(BLUE_COL "  Blue" RESET " - enter an empty cell (row col): ");
            }
        }
        else {
            if (game.go) {
                printf(RED_COL "  Red" RESET " - choose one of your pieces to Expand (row col): ");
            }
            else {
                printf(BLUE_COL "  Blue" RESET " - choose one of your pieces to Expand (row col): ");
            }
        }

        success = scanf("%d %d", &row, &col);

        if (success == 2) {
            clearLine();

			if (row == 0 && col == 0){		// kill switch for playtesting purposes
				printf("\n  Returning to main menu...\n\n");
				system("pause");
				return;
			}
				
            row--;
            col--;

            pos.x = row;
            pos.y = col;

            validMove = 0;

            if (isInside(pos)) {
                if (game.start) {
                    if (!game.R[row][col] && !game.B[row][col]) {
                        validMove = 1;
                    }
                    else {
                        printf("\n  Invalid move. Cell is already occupied.\n\n");
                    }
                }
                else {
                    if (game.go && game.R[row][col]) {
                        validMove = 1;
                    }
                    else if (!game.go && game.B[row][col]) {
                        validMove = 1;
                    }
                    else {
                        printf("\n  Invalid move. Choose one of your own pieces.\n\n");
                    }
                }
            }
            else {
                printf("\n  Invalid move. Row and column must be from 1 to 3 only.\n\n");
            }

            if (validMove) {
                NextPlayerMove(&game, pos);
            }
        }
        else {
            clearLine();
            printf("\n  Invalid input. Enter two integers only.\n\n");
        }
    }

    printGameBoard(&game);
    GameOver(&game);
	system("pause");
}

