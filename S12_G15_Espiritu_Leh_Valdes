                    break;
                case 3:
                    printCredits();
                    break;
                case 4:
                    printf("  Thanks for playing!\n\n");
                    break;
                default:
                    printf("  Invalid choice. Enter 1 to 4.\n\n");
            }
        }
        else {
            clearLine();
            printf("  Invalid input. Enter 1 to 4.\n\n");
        }
    }

    return 0;
}
