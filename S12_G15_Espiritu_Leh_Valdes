/*  2. LOGIC                                                                  */
/* ---------------------------------------------------------------------------*/

void clearLine(void) {
    int ch;

    ch = getchar();
    while (ch != '\n' && ch != EOF) {
        ch = getchar();
    }
}

/* checks for valid input -- if pos is within the 3x3 grid */
int isInside(Position pos) {
    int inside;

    inside = 0;

    if (pos.x >= 0 && pos.x < SIZE && pos.y >= 0 && pos.y < SIZE) {
        inside = 1;
    }

    return inside;
}

/* counts how many cells are occupied in the grid -- for game end condition*/
int countPieces(int grid[SIZE][SIZE]) {
    int count, i, j;

    count = 0;

    for (i = 0; i < SIZE; i++) {
        for (j = 0; j < SIZE; j++) {
            if (grid[i][j]) {
                count++;
            }
        }
    }

    return count;
}

/* counts how many cells are unoccupied */
int countFree(GameState *game) {
    int count, i, j;

    count = 0;

    for (i = 0; i < SIZE; i++) {
        for (j = 0; j < SIZE; j++) {
            if (!game->R[i][j] && !game->B[i][j]) {
                count++;
            }
        }
    }

    return count;
}

/* checks for game end conditions */
int isOver(GameState *game) {
    int r, b, wiped, over;

    r = countPieces(game->R);	// counts active red pieces
    b = countPieces(game->B);	// counts active blue pieces

	/* checks if a player has been completely wiped out */
    wiped = 0;
    if (!game->start && ((r > 0 && b == 0) || (r == 0 && b > 0))) {
        wiped = 1;
    }

	/* checks for if: board is nearly full, move limit is reacehd, or if a player has been wiped out */
    over = 0;
    if (countFree(game) == 3 || game->val >= 20 || wiped) {
        over = 1;
    }

    return over;
}

/* removes the current player's piece at pos and clears the visit/chain flags */
void Remove(GameState *game, Position pos) {
    if (game->go) {						// red's turn
        game->R[pos.x][pos.y] = 0;
    }
    else {								// blue's turn
        game->B[pos.x][pos.y] = 0;
    }

	/* clears visited and chain-expanded flags */
    game->S[pos.x][pos.y] = 0;
    game->T[pos.x][pos.y] = 0;
}

/* removes piece at current pos and "expands" it into neighboring cells -- blue and red have different behaviours */
void Expand(GameState *game, Position pos) {
    int a, b;
    Position u, d, k, r;

	// current coordinates
    a = pos.x;
    b = pos.y;

	// directly above
    u.x = a - 1;
    u.y = b;

	// directly below
    d.x = a + 1;
    d.y = b;

	// directly left
    k.x = a;
    k.y = b - 1;

	// directly right
    r.x = a;
    r.y = b + 1;

    Remove(game, pos); // removes current pos

	// red spreads upwards, blue spreads downwards
    if (game->go) {
        Replace(game, u);
    }
    else {
        Replace(game, d);
    }

	// both colours expand left and right
    Replace(game, k);
    Replace(game, r);
}

/* claims the cell/s occupied by the opponent */
void Replace(GameState *game, Position pos) {
    if (isInside(pos)) {		// outbound check
        game->found = 0;		// reset found flag

		/* red's expansion */
		/* capturing a blue piece */
        if (game->go && game->B[pos.x][pos.y]) {
            game->B[pos.x][pos.y] = 0;
            game->found = 1;
        }

		/* tries to capture own piece */
        if (game->go && game->R[pos.x][pos.y]) {
            game->found = 1;
        }

		/* claims empty cell */
        if (game->go && !game->R[pos.x][pos.y]) {
            game->R[pos.x][pos.y] = 1;
        }

		/* blue's expansion */
		/* capturing a red piece */
        if (!game->go && game->R[pos.x][pos.y]) {
            game->R[pos.x][pos.y] = 0;
            game->found = 1;
        }

		/* tries to capture own piece */
        if (!game->go && game->B[pos.x][pos.y]) {
            game->found = 1;
        }

		/* claims empty cell */
        if (!game->go && !game->B[pos.x][pos.y]) {
            game->B[pos.x][pos.y] = 1;
        }

		/* marks a cell as "visited" when it is first hit by expansion */
        if (game->found && !game->S[pos.x][pos.y]) {
            game->S[pos.x][pos.y] = 1;
            game->found = 0;
        }

		/*	triggers a chain reaction when the cell is hit a second time */
        if (game->found && game->S[pos.x][pos.y] && !game->T[pos.x][pos.y]) {
            game->T[pos.x][pos.y] = 1;
            Expand(game, pos);
        }
    }
}

/* expansion move on occupied tile*/
void Update(GameState *game, Position pos) {
    game->good = 0;

	/* marks unvisited cells and flags it as visited */
    if (!game->S[pos.x][pos.y]) {
        game->S[pos.x][pos.y] = 1;
        game->good = !game->good;
    }

	/* trigger expansion if the cell has already been visited */
    if (!game->good && game->S[pos.x][pos.y] && !game->T[pos.x][pos.y]) {
        game->T[pos.x][pos.y] = 1;
        Expand(game, pos);
    }
}

/* turn order and validity checks */
void NextPlayerMove(GameState *game, Position pos) {
    if (!isOver(game) && game->start) {
        if (game->go) {
            game->R[pos.x][pos.y] = 1;
        }
        else {
            game->B[pos.x][pos.y] = 1;
        }

        game->S[pos.x][pos.y] = 1;
        game->good = 1;
    }

    if (!isOver(game) && !game->start) {
        if ((game->go && game->R[pos.x][pos.y]) ||
            (!game->go && game->B[pos.x][pos.y])) {
            Update(game, pos);
            game->good = 1;
        }
    }

    if (game->start &&
        countPieces(game->R) == 1 &&
        countPieces(game->B) == 1) {
        game->start = 0;
    }

    if (!isOver(game) && game->good) {
        game->good = 0;
        game->go = !game->go;
        game->val++;
    }
}

/* prints end of game results */
void GameOver(GameState *game) {
    int r, b;

    r = countPieces(game->R);
    b = countPieces(game->B);

    printf("\n");
    printf(DIM "  -------------------------------------------\n" RESET);

    if (r > b) {
        printf(RED_COL BOLD "      RED WINS!" RESET
               "   Red: %d piece(s)  Blue: %d piece(s)\n", r, b);
    }
    else if (b > r) {
        printf(BLUE_COL BOLD "      BLUE WINS!" RESET
               "   Blue: %d piece(s)  Red: %d piece(s)\n", b, r);
    }
    else {
        printf(YELLOW BOLD "         DRAW!" RESET
               "   Both players have %d piece(s)\n", r);
    }

    printf(DIM "  -------------------------------------------\n" RESET);
    printf("\n");

    if (countFree(game) == 3) {
        printf("  -> Board is nearly full (only 3 empty cells left).\n");
    }
    else if (game->val >= 20) {
        printf("  -> 20 moves have been played.\n");
    }
    else if (b == 0) {
        printf("  -> " BLUE_COL "Blue" RESET " lost all their pieces!\n");
    }
    else if (r == 0) {
        printf("  -> " RED_COL "Red" RESET " lost all their pieces!\n");
    }

    printf("\n");
}

