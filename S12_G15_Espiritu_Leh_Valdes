#include <stdio.h>
#include <stdlib.h>

#define SIZE 3		// 3x3 board

#define RESET       "\033[0m"
#define BOLD        "\033[1m"
#define DIM         "\033[2m"

#define RED_COL     "\033[31m"
#define BLUE_COL    "\033[34m"
#define YELLOW      "\033[33m"
#define CYAN        "\033[36m"
#define GREEN       "\033[32m"

typedef struct Position {
    int x; /* row */
    int y; /* column */
} Position;

typedef struct {
    int R[SIZE][SIZE];		// cells occupied by red
    int B[SIZE][SIZE];		// cells occupied by blue
    int S[SIZE][SIZE];		// cells visited during expansion
    int T[SIZE][SIZE];		// cells that have already chain expanded
    
	/* FLAG VARIABLES */
	int good;				// validity of current move
    int go;					// 1 = red's turn; 0 = blue's turn
    int start;				// (1) placement & (0) expansion phases
    int found;				// expansion into occupied cell
    int val;				// move counter
} GameState;

