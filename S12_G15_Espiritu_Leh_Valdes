/*  1. INITIALIZATION                                                         */
/* ---------------------------------------------------------------------------*/

void initialize(GameState *game) {
    int i, j;

    for (i = 0; i < SIZE; i++) {
        for (j = 0; j < SIZE; j++) {
            game->R[i][j] = 0;
            game->B[i][j] = 0;
            game->S[i][j] = 0;
            game->T[i][j] = 0;
        }
    }

    game->good = 0;		// no valid move yet
    game->go = 1;		// red moves first
    game->start = 1;	// placement phase first
    game->found = 0;	// nothing found
    game->val = 0;		// no moves played
}

